<?xml version="1.0"?>
<launch>
    <!-- Launch file - 仅点云坐标变换节点（不启动雷达驱动） -->

    <!-- 话题配置 -->
    <arg name="pointcloud_topic" default="/livox/lidar" />
    <arg name="odometry_topic" default="/mavros/local_position/odom" />
    <arg name="output_frame" default="world" />
    
    <!-- 同步参数 -->
    <arg name="time_sync_window" default="0.1" />
    
    <!-- 滤波参数 -->
    <arg name="enable_filter" default="true" />
    <arg name="filter_range" default="0.5" />
    
    <!-- 地面滤波参数 -->
    <arg name="enable_ground_filter" default="false" />
    <arg name="ground_filter_height" default="0.0" />




    <!-- 点云坐标系转换节点 -->
    <node pkg="test" type="livoxpc_transform_node" name="livoxpc_transform_node" output="screen">
        <param name="pointcloud_topic" value="$(arg pointcloud_topic)" />
        <param name="odometry_topic" value="$(arg odometry_topic)" />
        <param name="output_frame" value="$(arg output_frame)" />
        <param name="time_sync_window" value="$(arg time_sync_window)" />
        <param name="enable_filter" value="$(arg enable_filter)" />
        <param name="enable_ground_filter" type="bool" value="$(arg enable_ground_filter)" />
        <param name="ground_filter_height" type="double" value="$(arg ground_filter_height)" />
        <param name="filter_range" value="$(arg filter_range)" />
    </node>

</launch>